[Unit]
Description=FalconFeeds source URL scraper
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/falcon-feeds
ExecStart=/usr/bin/docker compose up --build --remove-orphans scraper
ExecStop=/usr/bin/docker compose stop scraper
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
